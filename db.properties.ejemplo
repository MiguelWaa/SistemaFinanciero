# ============================================================
#  SIGSF · Configuración del sistema  (PLANTILLA VERSIONADA)
#
#  Este archivo SÍ está en Git y trae valores de laboratorio para que el
#  proyecto funcione recién clonado. Para tu configuración local:
#
#      copy db.properties.ejemplo db.properties     (Windows)
#      cp   db.properties.ejemplo db.properties     (Linux/Mac)
#
#  y edita db.properties: ese archivo NO se versiona (.gitignore) y el
#  hook pre-commit impide subirlo por error. El programa lee primero
#  este ejemplo y luego db.properties, que tiene prioridad.
#  Cualquier clave puede darse también por variable de entorno
#  (SIGSF_ + clave en mayúsculas), p. ej. SIGSF_DB_PASSWORD.
# ============================================================

# --- Persistencia ---
#  postgresql = base de datos real (producción)
#  memoria    = modo demostración sin base de datos (datos de ejemplo, se pierden al cerrar)
persistencia=postgresql

# --- Base de datos PostgreSQL ---
db.host=localhost
db.port=5432
db.name=SistemaFinanciero
# Recomendado: usar el rol de privilegios mínimos creado por db/seguridad.sql
#   db.user=sigsf_app
db.user=postgres
# Contraseña de laboratorio. En un servidor real use SIGSF_DB_PASSWORD.
db.password=123456

# --- Servidor web / API ---
server.port=8091
web.dir=web
# Tamaño máximo del cuerpo de una petición (KB)
server.max.cuerpo.kb=1024
# Origen permitido para CORS. Vacío = solo el mismo origen (recomendado)
seguridad.cors.origen=

# --- Seguridad ---
# Minutos de inactividad para que expire la sesión
seguridad.sesion.minutos=30
# Intentos fallidos antes de bloquear la cuenta, y minutos de bloqueo
seguridad.intentos.max=5
seguridad.bloqueo.minutos=5
# Iteraciones PBKDF2 para cifrar contraseñas
seguridad.pbkdf2.iteraciones=120000

# --- Respaldos (backup) ---
backup.dir=respaldos
# Ruta de pg_dump; "auto" lo busca en el PATH y en C:\Program Files\PostgreSQL\*\bin
backup.pgdump=auto
# Cuántos respaldos conservar (los más antiguos se eliminan)
backup.retener=10
# Respaldo automático cada N horas (0 = desactivado)
backup.automatico.horas=24

# --- Pagos con Yape, Plin y Tunki (v5.2) ---
# false (recomendado): el pago del portal queda POR_VERIFICAR hasta que caja lo confirma.
# true: se confirma al registrarlo (solo para demostraciones).
pagos.confirmacion.automatica=false
# Monto máximo (S/) aceptado en un solo pago
pagos.monto.maximo=10000
