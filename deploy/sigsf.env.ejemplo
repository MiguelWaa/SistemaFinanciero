# ============================================================
#  SIGSF 5.11.0 · Variables de despliegue (PLANTILLA)
#  Copie a deploy/sigsf.env (no versionado) y cambie las contraseñas.
#  En servidor Linux con systemd: /etc/sigsf/sigsf.env (chmod 600).
#  Toda clave de db.properties se puede dar como SIGSF_<CLAVE>.
# ============================================================
SIGSF_VERSION=5.11.0
SIGSF_IMAGEN=ghcr.io/miguelwaa/sigsf
SIGSF_PUERTO_PUBLICO=8091

SIGSF_PERSISTENCIA=postgresql
SIGSF_DB_HOST=127.0.0.1
SIGSF_DB_PORT=5432
SIGSF_DB_NAME=SistemaFinanciero
# Rol de privilegios mínimos creado por db/seguridad.sql
SIGSF_DB_USER=sigsf_app
SIGSF_DB_PASSWORD=CAMBIAR_ANTES_DE_DESPLEGAR

SIGSF_SERVER_PORT=8091
SIGSF_SESION_MINUTOS=30
SIGSF_BACKUP_AUTOMATICO_HORAS=24
SIGSF_BACKUP_RETENER=10
