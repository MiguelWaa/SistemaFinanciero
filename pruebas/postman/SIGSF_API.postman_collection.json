                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/health",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 800 ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));",
