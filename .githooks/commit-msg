#!/bin/sh
# ============================================================
#  SIGSF · Hook commit-msg: exige Conventional Commits
#     tipo(ámbito opcional): descripción
#  tipos: feat fix docs style refactor perf test build ci chore revert
#  Se aceptan también los mensajes automáticos de merge y revert.
# ============================================================
primera=$(head -n 1 "$1")
case "$primera" in
  Merge*|Revert*|fixup!*|squash!*) exit 0;;
esac
if echo "$primera" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{5,}'; then
  exit 0
fi
echo "[commit-msg] Mensaje no válido: \"$primera\""
echo "             Formato: tipo(ámbito): descripción   p. ej.  feat(ventas): exportar a CSV"
echo "             Tipos: feat fix docs style refactor perf test build ci chore revert"
exit 1
